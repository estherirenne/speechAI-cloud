# Salin file ini jadi .env lalu ganti semua nilai "change_me".
# JANGAN commit file .env ke Git.
POSTGRES_DB=speechai
POSTGRES_USER=speechai_admin
POSTGRES_PASSWORD=change_me_admin_password
APP_DB_PASSWORD=change_me_app_password
JWT_SECRET=change_me_long_random_string

# Ollama jalan di Mac (di luar Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
